# Sekai clerk plane (ADR 0082). One database. Loopback by default.
ARG RUST_IMAGE=rust:1.98.1-bookworm
FROM ${RUST_IMAGE} AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release --bin sekai

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home sekai \
    && mkdir /data && chown sekai:sekai /data
COPY --from=build /src/target/release/sekai /usr/local/bin/sekai
ENV DB_PATH=/data/sekai.db \
    SEKAI_SOCKET= \
    SEKAI_BIND=0.0.0.0 \
    GRPC_PORT=50051 \
    SEKAI_PLANE=sekai
VOLUME /data
EXPOSE 50051
USER sekai
CMD ["sekai"]
