{
  "contract_version": "sekai.managed-shikigami-routing-conformance/v1",
  "parent_issue": 471,
  "consumer": "Sannrox/shikigami",
  "minimum_consumer": {
    "released_version": null,
    "intended_version": "v1.0.5",
