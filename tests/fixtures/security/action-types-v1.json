{
  "actions": [
    {
      "type_id": "security.finding.record",
      "description": "Record a security finding. A second finding with the same signature is refused; record an occurrence instead.",
      "object_kind": "security_finding",
      "object_mutation": "create",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "probe",
              "review",
              "scanner",
              "agent",
              "advisory"
            ]
          },
          "component": {
            "type": "string"
          },
          "version_range": {
            "type": "string"
          },
          "problem_signature": {
            "type": "string"
          },
          "reported_severity": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "string"
          },
          "finding_class": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "source",
          "component",
          "version_range",
          "problem_signature",
          "reported_severity"
        ]
      }
    },
    {
      "type_id": "security.occurrence.record",
      "description": "Record one measured occurrence of a finding. A repeated occurrence id is refused.",
      "object_kind": "security_finding_occurrence",
      "object_mutation": "create",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          },
          "occurrence_id": {
            "type": "string"
          },
          "observed_at_ms": {
            "type": "integer"
          },
          "evidence_refs": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "finding_id",
          "occurrence_id",
          "observed_at_ms"
        ]
      }
    },
    {
      "type_id": "security.hypothesis.record",
      "description": "Record a hypothesis about a finding. It is not a measured fact.",
      "object_kind": "security_hypothesis",
      "object_mutation": "create",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "finding_id",
          "statement"
        ]
      }
    },
    {
      "type_id": "security.exposure.record",
      "description": "Record one finding against one deployed target with a verdict.",
      "object_kind": "security_exposure",
      "object_mutation": "create",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          },
          "release": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "exploitable",
              "not-reachable",
              "mitigated",
              "unknown"
            ]
          },
          "evidence_id": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "finding_id",
          "release",
          "environment",
          "verdict"
        ]
      }
    },
    {
      "type_id": "security.exposure.verdict",
      "description": "Change an exposure's verdict and the measured evidence it relies on. The target identity does not change.",
      "object_kind": "security_exposure",
      "object_mutation": "update",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "exploitable",
              "not-reachable",
              "mitigated",
              "unknown"
            ]
          },
          "evidence_id": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "verdict"
        ]
      }
    },
    {
      "type_id": "security.disposition.record",
      "description": "Record the first disposition on an exposure with its validity basis. Accepting risk on marked data needs the disposition marked at least as high as that data.",
      "object_kind": "security_disposition",
      "object_mutation": "create",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "exposure_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "accept-risk",
              "false-positive",
              "mitigated",
              "fixed"
            ]
          },
          "dependency_closure_digest": {
            "type": "string"
          },
          "release_digest": {
            "type": "string"
          },
          "configuration_digest": {
            "type": "string"
          },
          "reachable_markings": {
            "type": "string"
          },
          "advisory_revision": {
            "type": "string"
          },
          "asset_criticality": {
            "type": "string"
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "rationale": {
            "type": "string"
          },
          "access_marking": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "exposure_id",
          "disposition",
          "dependency_closure_digest",
          "release_digest",
          "configuration_digest",
          "advisory_revision"
        ]
      }
    },
    {
      "type_id": "security.disposition.supersede",
      "description": "Replace a disposition with a new one on the same exposure. The previous disposition and its receipt are kept.",
      "object_kind": "security_disposition",
      "object_mutation": "create",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "exposure_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "accept-risk",
              "false-positive",
              "mitigated",
              "fixed"
            ]
          },
          "dependency_closure_digest": {
            "type": "string"
          },
          "release_digest": {
            "type": "string"
          },
          "configuration_digest": {
            "type": "string"
          },
          "reachable_markings": {
            "type": "string"
          },
          "advisory_revision": {
            "type": "string"
          },
          "asset_criticality": {
            "type": "string"
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "rationale": {
            "type": "string"
          },
          "access_marking": {
            "type": "string"
          },
          "supersedes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "object_id",
          "exposure_id",
          "disposition",
          "dependency_closure_digest",
          "release_digest",
          "configuration_digest",
          "advisory_revision",
          "supersedes"
        ]
      }
    },
    {
      "type_id": "security.disposition.reopen",
      "description": "Return a disposition to needs-review because a fact of its validity basis changed or it expired. The previous disposition and its receipt are kept.",
      "object_kind": "security_disposition",
      "object_mutation": "create",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "exposure_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "needs-review"
            ]
          },
          "dependency_closure_digest": {
            "type": "string"
          },
          "release_digest": {
            "type": "string"
          },
          "configuration_digest": {
            "type": "string"
          },
          "reachable_markings": {
            "type": "string"
          },
          "advisory_revision": {
            "type": "string"
          },
          "asset_criticality": {
            "type": "string"
          },
          "expires_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "access_marking": {
            "type": "string"
          },
          "supersedes": {
            "type": "string",
            "minLength": 1
          },
          "reopened_fact": {
            "type": "string",
            "enum": [
              "dependency_closure_digest",
              "release_digest",
              "configuration_digest",
              "reachable_markings",
              "advisory_revision",
              "expires_at_ms"
            ]
          },
          "reopened_value": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "exposure_id",
          "disposition",
          "dependency_closure_digest",
          "release_digest",
          "configuration_digest",
          "advisory_revision",
          "supersedes",
          "reopened_fact"
        ]
      }
    },
    {
      "type_id": "security.exposure.basis",
      "description": "Record the current facts of an exposure's deployed target. A disposition whose basis no longer matches them returns to needs-review.",
      "object_kind": "security_exposure",
      "object_mutation": "update",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "dependency_closure_digest": {
            "type": "string"
          },
          "release_digest": {
            "type": "string"
          },
          "configuration_digest": {
            "type": "string"
          },
          "reachable_markings": {
            "type": "string"
          },
          "advisory_revision": {
            "type": "string"
          }
        },
        "required": [
          "object_id"
        ]
      }
    },
    {
      "type_id": "security.probe.bind",
      "description": "Bind a regression probe to a fixed disposition. The probe must fail on the vulnerable revision and pass on the fixed one; until one is bound the exposure reads needs-probe.",
      "object_kind": "security_regression_probe",
      "object_mutation": "create",
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "disposition_id": {
            "type": "string",
            "minLength": 1
          },
          "probe_kind": {
            "type": "string",
            "enum": [
              "catalogue",
              "external"
            ]
          },
          "probe_ref": {
            "type": "string",
            "minLength": 1
          },
          "vulnerable_revision": {
            "type": "string",
            "minLength": 1
          },
          "vulnerable_result": {
            "type": "string",
            "enum": [
              "fail",
              "pass"
            ]
          },
          "fixed_revision": {
            "type": "string",
            "minLength": 1
          },
          "fixed_result": {
            "type": "string",
            "enum": [
              "fail",
              "pass"
            ]
          },
          "access_marking": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "disposition_id",
          "probe_kind",
          "probe_ref",
          "vulnerable_revision",
          "vulnerable_result",
          "fixed_revision",
          "fixed_result"
        ]
      }
    }
  ]
}
