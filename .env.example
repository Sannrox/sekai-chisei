# Local development defaults.
SEKAI_INSECURE=1
GRPC_PORT=50051
# SEKAI_BIND=127.0.0.1
# Ops listener: /healthz, /readyz, /metrics (unauthenticated) and /console/*
# (authenticated operator shell). Keep on loopback unless a proxy owns access.
OPS_PORT=9464
OPS_BIND=127.0.0.1
SEKAI_SOCKET=./data/sekai.sock
# SQLite is the default community runtime backend. PostgreSQL is also supported
# for the complete reusable public control plane (no tenant/OIDC/OAuth).
SEKAI_DB_BACKEND=sqlite
DB_PATH=./data/sekai.db
# Optional comma-separated logical checkpoint providers accepted on parked
# runtime work. Values are opaque provider ids, not URLs or filesystem paths.
# Unset means parking is allowed only without checkpoint metadata.
# SEKAI_CHECKPOINT_STORES=shikigami-local
# Multi-region budget topology (#294). Default single_region. Regional modes
# require SEKAI_BUDGET_SITE_ID. active_active_global_sc is not supported.
# See docs/budget-topology.md.
# SEKAI_BUDGET_TOPOLOGY=single_region
# BUDGET_TOPOLOGY_MODE=single_region
# SEKAI_BUDGET_SITE_ID=us-east-1
# SEKAI_BUDGET_PARTITION_SIMULATED=0
# When SEKAI_DB_BACKEND=postgres, set DATABASE_URL and leave DB_PATH unset (the
# two are mutually exclusive). Migrations and capability validation run before
# listeners bind; incomplete schemas fail closed.
# SEKAI_DB_BACKEND=postgres
# DATABASE_URL=postgres://user:password@host/sekai
# SEKAI_POSTGRES_MAX_CONNECTIONS=16
# SEKAI_POSTGRES_CA_CERT=/path/to/ca.pem
# Shared lifecycle state; defaults beside DB_PATH when unset. Its directory must
# support same-directory hard links so fresh lock records can publish atomically.
# CHISEI_PROVIDER_REGISTRY_STATE_PATH=./data/provider-registry-state.json
# One-time recovery for a legacy empty .lock with no state or initialization marker.
# CHISEI_PROVIDER_REGISTRY_ALLOW_LEGACY_INITIALIZATION=1
OLLAMA_URL=http://localhost:11434

# Logging. Set LOG_FORMAT=json for structured JSON logs.
# RUST_LOG=info
# LOG_FORMAT=pretty

# Authenticated mode (legacy fallback). Set this to bootstrap a temporary single principal
# `root` deployment or for compatibility. Prefer `sekaictl credential ...` for production.
# SEKAI_AUTH_TOKEN=change-me

# Optional TLS settings.
# SEKAI_TLS_CERT=/path/to/server-cert.pem
# SEKAI_TLS_KEY=/path/to/server-key.pem
# Outbound clients only: CA PEM to trust a private server CA (not server mTLS).
# SEKAI_TLS_CA=/path/to/ca-cert.pem
# SEKAI_ALLOW_PLAINTEXT=1

# Region/site pin for coordination leases and online permit redemption (#293).
# Default "local" is the single-region pin. Multi-region deployments set a
# distinct non-empty id per site (no wildcards). Cross-region refresh,
# takeover, and redeem fail closed; handoff is a non-goal for v1.
# SEKAI_SITE_ID=local

# Optional provider credentials.
# OPENAI_API_KEY=
# Used by `sekaictl launch claude-code`: when set, the gateway swaps this key in
# upstream for api.anthropic.com. When unset, launch leaves Claude Code's own
# subscription OAuth token in place and forwards it unchanged (passthrough).
# ANTHROPIC_API_KEY=
# Optional external secrets-manager adapter. Build with `--features
# secret-command`; the executable receives the opaque reference as one argument
# and writes only the secret value to stdout. Direct API-key env vars win.
# CHISEI_SECRET_COMMAND=/usr/local/bin/chisei-secret-adapter
# CHISEI_OPENAI_API_KEY_SECRET=kms://project/openai
# CHISEI_ANTHROPIC_API_KEY_SECRET=kms://project/anthropic
# NATIVE_LLM_URL=
# LLM_HTTP_CONNECT_TIMEOUT_SECS=10
# LLM_HTTP_READ_TIMEOUT_SECS=60
# LLM_HTTP_POOL_IDLE_TIMEOUT_SECS=90
# LLM_HTTP_REQUEST_TIMEOUT_SECS=120

# Privacy egress controls.
# CHISEI_DEFAULT_DATA_CLASS=unclassified
# CHISEI_SAFE_EGRESS_PROVIDERS=native
# LEAK_REVIEW_MODEL=ollama/llama3.2:latest

# Providers whose upstream auth is supplied by the gateway rather than this
# server (e.g. Codex ChatGPT-plan passthrough). Model routing treats them as
# available without a local key. `sekaictl launch` sets this automatically for
# the server it starts: `openai` for codex-app, `anthropic` for claude-code.
# CHISEI_GATEWAY_PROVIDED_PROVIDERS=openai
# Token-authenticated service principals allowed to write gateway receipts.
# CHISEI_GATEWAY_RECEIPT_PRINCIPALS=gateway-prod

# Gateway upstream for `ollama/*` models (per-model backend routing). Defaults
# to ${OLLAMA_URL}/v1, i.e. http://localhost:11434/v1.
# CHISEI_OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional chisei-gateway settings.
# GATEWAY_PORT=8788
# CHISEI_OPENAI_BASE_URL=https://api.openai.com/v1
# Provider model catalogs are cached; routing reads this cache and never fetches
# a catalog directly on each candidate-selection pass.
# CHISEI_MODEL_DISCOVERY_TTL_SECS=300
# CHISEI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# XAI_API_KEY=
# CHISEI_XAI_BASE_URL=https://api.x.ai/v1
# META_MODEL_API_KEY=
# CHISEI_META_BASE_URL=
# CHISEI_GRPC_URL=./data/sekai.sock
# Gateway virtual keys (HTTP client auth) are separate from gRPC principal
# credentials. Seed durable keys with:
#   cargo run --bin sekaictl -- gateway setup ...
#   cargo run --bin sekaictl -- gateway key create ...
# Use `sekaictl credential create` only for control-plane gRPC tokens.
# GATEWAY_KEYS is an optional env allowlist for development/compose; it does
# not replace gateway setup. Non-loopback binds require at least one key.
# GATEWAY_KEYS=sk-chisei-codex-app=codex-app:sekai-chisei
# GATEWAY_DEFAULT_PROJECT=default
# Accept Codex/OpenAI local-login requests for identity, but replace their
# upstream bearer with OPENAI_API_KEY. Useful because Codex local-login tokens
# are client auth, not raw api.openai.com API keys.
# CHISEI_GATEWAY_REWRITE_OPENAI_PASSTHROUGH_AUTH=1
# Sekai gateway-key lookup cache. POST /_chisei/admin/refresh clears it.
# CHISEI_GATEWAY_KEY_CACHE_TTL_SECS=30
# CHISEI_GATEWAY_MAX_REQUEST_BYTES=33554432
# CHISEI_GATEWAY_RATE_LIMIT_REQUESTS=120
# CHISEI_GATEWAY_GLOBAL_RATE_LIMIT_REQUESTS=1200
# CHISEI_GATEWAY_RATE_LIMIT_WINDOW_SECS=60
# CHISEI_GATEWAY_BUDGET_RECONCILIATION_PATH=data/chisei-gateway-budget-reconciliation.json
# Base path for durable receipt, usage, and refusal recovery records. Records
# are written to the sibling file with `.recovery` appended. The byte limit is
# a hard capacity; replay or archive processed records before it fills.
# CHISEI_GATEWAY_AUDIT_SPOOL_PATH=data/chisei-gateway-audit.jsonl
# CHISEI_GATEWAY_AUDIT_SPOOL_MAX_BYTES=67108864
# Control-plane retries and circuit breaker. Upstream retries apply only to
# connection failures, before a request can have been accepted by the provider.
# CHISEI_GATEWAY_CONTROL_PLANE_RETRIES=2
# CHISEI_GATEWAY_CONTROL_PLANE_RETRY_BACKOFF_MS=25
# CHISEI_GATEWAY_CONTROL_PLANE_TIMEOUT_MS=3000
# CHISEI_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
# CHISEI_GATEWAY_CIRCUIT_COOLDOWN_SECS=5
# CHISEI_GATEWAY_UPSTREAM_CONNECT_RETRIES=1
# Optional: enables POST /_chisei/admin/refresh. Use a random value of at
# least 32 bytes. When unset, the admin endpoint is disabled.
# CHISEI_GATEWAY_ADMIN_TOKEN=<random-32-byte-minimum-token>
# Optional static pricing table for estimated cost ledger rows.
# Format: model=input:output[:cache_read[:cache_write_5m[:cache_write_1h]]], USD/1M tokens.
# CHISEI_GATEWAY_PRICING=gpt-5.5=1.25:10:0.125,claude-sonnet-4-6=3:15:0.3:3.75:6
# Run the Chisei pipeline after completed calls and record sampling decisions.
# CHISEI_GATEWAY_RUN_PIPELINE=1
# Opt in to lossy cross-provider routing, such as Anthropic Messages to OpenAI
# Chat Completions. Non-streaming Anthropic -> OpenAI is the first supported
# bridge; raw same-provider passthrough remains the default.
# CHISEI_GATEWAY_ALLOW_CROSS_PROVIDER=1
# Ed25519 seed (64 lowercase hex characters) used to sign external-action permits.
# Keep this secret out of source control and rotate it through your secret manager.
# CHISEI_PERMIT_SIGNING_KEY=
CHISEI_PERMIT_ISSUER=chisei.local
CHISEI_PERMIT_KEY_ID=permit-key-1
